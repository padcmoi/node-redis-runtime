{
  "name": "@naskot/node-redis-runtime",
  "version": "0.1.0",
  "description": "Agnostic Redis runtime with persistent store and high-performance cache for Node.js",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./redisShared": {
      "types": "./dist/redisShared.d.ts",
      "import": "./dist/redisShared.js",
      "require": "./dist/redisShared.cjs"
    },
    "./service": {
      "types": "./dist/service.d.ts",
      "import": "./dist/service.js",
      "require": "./dist/service.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "docs"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/padcmoi/node-redis-runtime.git"
  },
  "homepage": "https://github.com/padcmoi/node-redis-runtime",
  "bugs": {
    "url": "https://github.com/padcmoi/node-redis-runtime/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts src/RedisStore.ts src/redisCache.ts src/redisShared.ts src/service.ts --format cjs,esm --dts --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "format": "prettier --write .",
    "ci": "npm ci && npm run lint && npm run typecheck && npm test && npm run build",
    "install:ci": "npm ci",
    "prepublishOnly": "npm run check"
  },
  "keywords": [
    "redis",
    "cache",
    "store",
    "typescript",
    "node"
  ],
  "dependencies": {
    "ioredis": "^5.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.6.0",
    "eslint": "^10.2.1",
    "prettier": "^3.8.3",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.58.2",
    "vitest": "^3.2.4"
  }
}
